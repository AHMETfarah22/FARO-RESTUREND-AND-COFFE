# ------------------------------------------------------------------
# FARO RESTURENT AND COFFE - Git Ignore Rules
# Security & Secret Protection
# ------------------------------------------------------------------

# Secrets & Environment Variables — NEVER COMMIT REAL SECRETS
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*
!**/.env.example

# Production configuration secrets
appsettings.Production.json
appsettings.*.local.json

# SSL / TLS certificates and private keys
*.pfx
*.p12
*.pem
*.key
*.cer
*.crt

# .NET build artifacts & caches
bin/
obj/
**/bin/
**/obj/
*.user
*.userosscache
*.suo
.vs/

# Node & Frontend build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Databases & local storage
*.db
*.sqlite
*.sqlite3

# OS & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Customer installation packages (paket-olustur.cmd)
/release/
