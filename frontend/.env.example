# FARO RESTURENT AND COFFE — frontend environment
# Only VITE_* variables reach the browser. Never put secrets here.

# API base URL. Leave empty in development: Vite proxies /api and /hubs to the backend.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api and /hubs (development only).
VITE_DEV_API_PROXY=http://localhost:5080
