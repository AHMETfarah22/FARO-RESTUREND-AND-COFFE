# ------------------------------------------------------------------
#  FARO RESTURENT AND COFFE - bu kurulumun ayarlari
#  Ilk acilista FARO-Baslat.cmd eksik degerleri sorar ve buraya yazar.
#  Degistirdikten sonra programi yeniden baslatin.
# ------------------------------------------------------------------

# PostgreSQL baglantisi (sifre ilk acilista sorulur)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=faro_restaurant;Username=postgres;Password=__POSTGRES_PASSWORD__

# Oturum imzasi (ilk acilista otomatik uretilir, kimseyle paylasmayin)
Jwt__Secret=__GENERATE__
# Personel oturumu 12 saat acik kalir (bir vardiya)
Jwt__ExpiresMinutes=720

# Adres: bu bilgisayar http://localhost:5080, ayni Wi-Fi'daki telefon/tabletler http://<bilgisayar-ip>:5080
ASPNETCORE_URLS=http://0.0.0.0:5080
ASPNETCORE_ENVIRONMENT=Production
App__HttpsRedirection=false
App__TimeZone=Europe/Istanbul

# Tablolari ilk acilista olustur / guncellemede tasi. Test verisi YUKLENMEZ.
Database__MigrateOnStartup=true
Database__SeedOnStartup=false

# Lisans anahtari program klasorunun (app) disinda saklanir, guncellemede kaybolmaz
License__FilePath=..\lisans.key

# Telefon bildirimleri (istege bagli, HTTPS gerektirir)
WebPush__Subject=mailto:info@example.com
WebPush__PublicKey=
WebPush__PrivateKey=
