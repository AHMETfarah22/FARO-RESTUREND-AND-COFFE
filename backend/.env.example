# ------------------------------------------------------------------
# FARO RESTURENT AND COFFE — backend environment (DEVELOPMENT TEMPLATE)
# Copy to backend/.env and fill in real values. Never commit .env.
# Keys use the ASP.NET Core "Section__Key" convention, so the same
# names work as real environment variables in production.
# ------------------------------------------------------------------

# PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=faro_restaurant;Username=postgres;Password=CHANGE_ME

# JWT (used from Phase 2). Secret must be at least 32 characters.
Jwt__Secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=FaroRestaurant.Api
Jwt__Audience=FaroRestaurant.Client
Jwt__ExpiresMinutes=120

# Comma-separated list of allowed frontend origins
Cors__AllowedOrigins=http://localhost:5173

# Web Push for customer 'order ready' notifications (optional).
# Generate a VAPID key pair, e.g.: npx web-push generate-vapid-keys
WebPush__Subject=mailto:info@example.com
WebPush__PublicKey=
WebPush__PrivateKey=
